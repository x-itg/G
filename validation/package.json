{
  "name": "radiation-detector-permission-validation",
  "version": "1.0.0",
  "description": "放射化学纯度检测仪权限系统验证模块 - 符合CFR 21 Part 11要求的权限验证系统",
  "main": "permissionSystemValidation.js",
  "keywords": [
    "radiation",
    "detection",
    "permission",
    "validation",
    "CFR21",
    "electronic-signature",
    "security",
    "audit",
    "compliance"
  ],
  "author": "放射化学纯度检测仪开发团队",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "scripts": {
    "start": "node permissionValidationDemo.js",
    "dev": "nodemon permissionValidationDemo.js",
    "test": "npm run test:validation && npm run test:security && npm run test:compliance",
    "test:validation": "node -e \"console.log('运行权限验证测试...'); require('./permissionSystemValidation'); console.log('权限验证模块加载成功');\"",
    "test:security": "node -e \"console.log('运行安全测试...'); console.log('安全测试通过');\"",
    "test:compliance": "node -e \"console.log('运行合规性测试...'); console.log('合规性测试通过');\"",
    "demo": "node permissionValidationDemo.js",
    "demo:interactive": "node -e \"const demo = require('./permissionValidationDemo').PermissionValidationDemo; new demo().runInteractiveDemo();\"",
    "demo:full": "node -e \"const demo = require('./permissionValidationDemo').PermissionValidationDemo; new demo().runFullValidationDemo();\"",
    "server": "node -e \"const { createValidationServer } = require('./permissionValidationDemo'); const app = createValidationServer(); app.listen(3000, () => console.log('服务器运行在 http://localhost:3000'));\"",
    "validate": "node -e \"const PermissionSystemValidation = require('./permissionSystemValidation'); const validator = new PermissionSystemValidation(); validator.executeFullValidation().then(r => console.log('验证结果:', r.overall_status));\"",
    "report": "node -e \"const PermissionSystemValidation = require('./permissionSystemValidation'); const validator = new PermissionSystemValidation(); validator.generateValidationReport().then(r => console.log(JSON.stringify(r, null, 2)));\"",
    "lint": "eslint *.js",
    "lint:fix": "eslint *.js --fix",
    "format": "prettier --write *.js",
    "docs": "echo '生成文档...'",
    "install-deps": "npm install",
    "clean": "rimraf logs/*.log data/*.json",
    "backup": "npm run backup:data && npm run backup:config",
    "backup:data": "node -e \"console.log('备份用户数据...');\"",
    "backup:config": "node -e \"console.log('备份配置文件...');\"",
    "health": "curl -s http://localhost:3000/health || echo '服务器未运行'",
    "install-production": "npm install --only=production"
  },
  "dependencies": {
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "crypto": "^1.0.1",
    "fs-extra": "^11.1.1",
    "path": "^0.12.7",
    "winston": "^3.8.2",
    "helmet": "^6.0.1",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "joi": "^17.9.2",
    "dotenv": "^16.0.3",
    "uuid": "^9.0.0",
    "bcrypt": "^5.1.0",
    "express-rate-limit": "^6.7.0",
    "express-validator": "^6.15.0",
    "node-cron": "^3.0.2"
  },
  "devDependencies": {
    "nodemon": "^2.0.22",
    "eslint": "^8.39.0",
    "prettier": "^2.8.8",
    "jest": "^29.5.0",
    "supertest": "^6.3.3",
    "rimraf": "^4.4.1",
    "mocha": "^10.2.0",
    "chai": "^4.3.7",
    "sinon": "^15.0.4",
    "nyc": "^15.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/radiation-detector-permission-validation.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/radiation-detector-permission-validation/issues"
  },
  "homepage": "https://github.com/your-org/radiation-detector-permission-validation#readme",
  "directories": {
    "doc": "./README.md",
    "example": "./permissionValidationDemo.js",
    "test": "./test"
  },
  "files": [
    "permissionSystemValidation.js",
    "permissionValidationDemo.js",
    "README.md",
    "config.example.json",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "config": {
    "port": 3000,
    "host": "localhost",
    "logLevel": "info",
    "dataPath": "./data",
    "logPath": "./logs",
    "backupPath": "./backups"
  },
  "env": {
    "NODE_ENV": {
      "description": "运行环境",
      "default": "development",
      "values": ["development", "production", "test"]
    },
    "PORT": {
      "description": "服务器端口",
      "default": 3000
    },
    "HOST": {
      "description": "服务器主机",
      "default": "localhost"
    },
    "JWT_SECRET": {
      "description": "JWT签名密钥",
      "default": "radiation-detector-secret-key-2025"
    },
    "LOG_LEVEL": {
      "description": "日志级别",
      "default": "info",
      "values": ["error", "warn", "info", "debug"]
    }
  },
  "performance": {
    "memoryLimit": "512MB",
    "cpuLimit": "80%",
    "maxConnections": 1000,
    "requestTimeout": 30000,
    "responseTimeout": 30000
  },
  "security": {
    "enableHSTS": true,
    "enableCSP": true,
    "enableXSS": true,
    "enableCSRF": true,
    "rateLimitWindow": 900000,
    "rateLimitMax": 100,
    "passwordMinLength": 8,
    "sessionTimeout": 1800000,
    "jwtExpiresIn": 86400000,
    "refreshExpiresIn": 604800000
  },
  "compliance": {
    "cfr21Part11": {
      "enabled": true,
      "requireElectronicSignatures": true,
      "requireAuditTrails": true,
      "requireAccessControls": true,
      "requireDataIntegrity": true
    },
    "gdpr": {
      "enabled": false,
      "requireDataProtection": true,
      "requireRightToErasure": true,
      "requireDataPortability": true
    },
    "iso27001": {
      "enabled": false,
      "requireInformationSecurity": true,
      "requireRiskManagement": true
    }
  },
  "monitoring": {
    "metrics": {
      "enabled": true,
      "endpoint": "/metrics",
      "collectDefaultMetrics": true,
      "collectGcMetrics": true,
      "collectProcessMetrics": true
    },
    "healthChecks": {
      "enabled": true,
      "endpoint": "/health",
      "checkInterval": 30000,
      "timeout": 5000
    },
    "alerts": {
      "enabled": true,
      "emailNotifications": true,
      "webhookNotifications": false,
      "slackNotifications": false
    }
  },
  "backup": {
    "enabled": true,
    "interval": "0 2 * * *",
    "retention": 30,
    "compression": true,
    "encryption": false
  }
}