# 放射检测仪 CFR 21 Part 11 合规系统配置文件

# 应用配置
NODE_ENV=development
APP_NAME=Radiation Detector CFR21
APP_VERSION=1.0.0
APP_PORT=3000

# 数据库配置
DATABASE_URL=sqlite:./database/radiation_detector.db
DB_ENCRYPTION_KEY=your-secret-encryption-key-here

# 认证配置
JWT_SECRET=your-jwt-secret-key-here
SESSION_SECRET=your-session-secret-key-here
SIGNATURE_SECRET=your-signature-secret-key-here

# 密码策略
PASSWORD_MIN_LENGTH=8
PASSWORD_EXPIRY_DAYS=90
MAX_FAILED_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# 串口配置
SERIAL_BAUD_RATE=9600
SERIAL_DATA_BITS=8
SERIAL_PARITY=none
SERIAL_STOP_BITS=1

# 电子签名配置
ENABLE_SECOND_FACTOR=false
SIGNATURE_REQUIRED_FIELDS=password,reason
SIGNATURE_TIMEOUT_MINUTES=60

# 审计配置
AUDIT_RETENTION_YEARS=7
ENABLE_HASH_CHAIN=true
MAX_AUDIT_RECORDS_PER_DAY=10000

# 文件配置
MAX_FILE_SIZE_MB=100
ALLOWED_FILE_EXTENSIONS=json,csv,txt,pdf
UPLOAD_PATH=./uploads

# 日志配置
LOG_LEVEL=info
LOG_FILE=./logs/app.log
LOG_MAX_SIZE_MB=10
LOG_MAX_FILES=5

# 备份配置
BACKUP_ENABLED=true
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=30
AUTO_BACKUP_INTERVAL_HOURS=24

# 性能配置
MAX_CONCURRENT_CONNECTIONS=10
REQUEST_TIMEOUT_MS=30000
DATA_BUFFER_SIZE=1000

# 开发配置
ENABLE_DEBUG_MODE=true
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_API_DOCS=true

# 生产配置（当 NODE_ENV=production 时启用）
# SSL_ENABLED=true
# SSL_CERT_PATH=./ssl/cert.pem
# SSL_KEY_PATH=./ssl/key.pem
# FORCE_HTTPS=true
# ENABLE_RATE_LIMITING=true