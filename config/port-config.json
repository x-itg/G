{
  "ports": {
    "description": "服务端口配置",
    "frontend": {
      "port": 3000,
      "description": "前端Web服务端口（与后端共享）",
      "protocol": "http"
    },
    "backend": {
      "port": 3000,
      "description": "后端API服务端口",
      "protocol": "http"
    },
    "electron": {
      "port": 0,
      "description": "Electron应用端口(0表示自动分配)",
      "protocol": "electron"
    }
  },
  "host": {
    "default": "localhost",
    "description": "默认主机地址"
  },
  "cors": {
    "enabled": true,
    "origin": "http://localhost:3000",
    "methods": ["GET", "POST", "PUT", "DELETE"],
    "allowedHeaders": ["Content-Type", "Authorization"],
    "credentials": true
  },
  "timeout": {
    "request": 30000,
    "response": 30000,
    "idle": 300000
  },
  "rateLimit": {
    "windowMs": 900000,
    "max": 100,
    "message": "请求过于频繁，请稍后再试"
  }
}
